# Compose interpolation only. The application's own variables live in backend/.env and
# frontend/.env.local — nothing here is a secret.
#
# Copy to .env. Set both to the output of `id -u` / `id -g` so the files a container
# creates inside ./backend and ./frontend (node_modules, package-lock.json) are owned by
# you rather than root. When unset the containers run as root (uid 0) instead.
LOCAL_UID=1001
LOCAL_GID=1001
